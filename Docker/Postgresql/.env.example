# Copy this file to "Docker/Postgresql/.env" (same directory as
# docker-compose.yaml) and fill in, at minimum, the 5 variables marked
# as REQUIRED.
# Docker/Postgresql/.env must NEVER be committed to version control.

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
POSTGRES_USER=argyon
# REQUIRED. Generate a strong password, for example:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=argyon
# Host/port the backend connects to. By default they point to this compose's
# own "db" container (argyon-db); only change them if you're going to use a
# PostgreSQL server external to the compose.
# POSTGRES_HOST=argyon-db
# POSTGRES_PORT=5432

# ------------------------------------------------------------------
# API cryptographic secrets (Jwt / Totp)
# Generate each one with, for example: openssl rand -base64 48
# ------------------------------------------------------------------
# REQUIRED
JWT_PASSWORD=
# REQUIRED
JWT_SALT=
# REQUIRED
TOTP_ENCRYPTION_PASSWORD=
# REQUIRED
TOTP_ENCRYPTION_SALT=

# ------------------------------------------------------------------
# Remaining parameters (optional; default values shown)
# ------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production
# BACKEND_PORT=8080

# The rest of the NON-sensitive configuration (Cors, ForwardedHeaders, Jwt
# Issuer/Audience/expiration, VaultFreshness, Attachments, RateLimiting) is
# NOT defined here as environment variables: docker-compose.yaml mounts
# Docker/Postgresql/appsettings.json with those default values. To change
# them, edit that file directly.
